{
  "private": true,
  "type": "module",
  "scripts": {
    "designer:dev": "vite --config designer/vite.config.ts",
    "designer:typecheck": "tsc --project designer/tsconfig.json --noEmit",
    "designer:test": "vitest run --config designer/vite.config.ts",
    "designer:build": "vite build --config designer/vite.config.ts",
    "designer:verify": "npm run designer:typecheck && npm run designer:test && npm run designer:build",
    "test:transcription:unit": "node --test tests/js/transcription/*.test.mjs",
    "test:speech:unit": "node --test tests/js/speech/*.test.mjs",
    "test:valerian:lifecycle": "playwright test --config=playwright.config.mjs tests/playwright/valerian-lifecycle.spec.mjs",
    "test:valerian:transcription": "playwright test --config=playwright.config.mjs tests/playwright/valerian-transcription.spec.mjs",
    "test:apiworkbench:visual": "playwright test --config=playwright.config.mjs tests/playwright/apiworkbench.spec.mjs",
    "test:participate:visual": "playwright test --config=playwright.participate.config.mjs",
    "test:valerian:visual": "playwright test --config=playwright.config.mjs tests/playwright/valerian-column-expansion.spec.mjs",
    "test:talktome:visual": "playwright test --config=playwright.config.mjs tests/playwright/talktome.spec.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.11.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.12.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
