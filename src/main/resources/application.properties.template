# dbms and db connection data
spring.application.name=prometheus
spring.datasource.url=jdbc:mysql://localhost:3306/prometheus?useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=achselle9

spring.jpa.properties.hibernate.dialect = org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update

# log level
logging.level.ch.zhaw.prometheus=INFO
logging.level.org=ERROR
logging.level.com=ERROR

# tomcat server port
server.port = 8080

# continuous evaluation (Iteration 4)
prometheus.runtime.tick.enabled=false
prometheus.runtime.tick.delay-ms=1000

# Volatile background transition actions. Unfinished work is lost on restart.
prometheus.actions.parallelism=4
prometheus.actions.capacity=64
prometheus.actions.queue-timeout-ms=30000

# Eligible conversational behaviour overlaps transition decisions. No queued workers.
prometheus.behaviour.speculation.enabled=true
prometheus.behaviour.speculation.parallelism=2
prometheus.behaviour.speculation.capacity=64
prometheus.behaviour.speculation.ttl-ms=30000

# admin access-code management
prometheus.admin.token=

# cross-origin browser clients, for example an external Valerian cockpit
prometheus.cors.allowed-origins=
prometheus.cors.allowed-origin-patterns=
