{
  "name": "social_initiative_mvp_replay_v1",
  "steps": [
    {
      "id": "start-conversation",
      "action": "start",
      "expectedBehaviour": {
        "speech": "Hello everyone. I can help if you need anything.",
        "nonVerbal": {
          "gesture": "POLITE"
        }
      }
    },
    {
      "id": "ack-face-alice-transition-to-social",
      "action": "acknowledge",
      "event": {
        "type": "obs.emotion.face",
        "actor": "user",
        "kind": "observation",
        "payload": "{\"source\":\"visual.multifacial\",\"userName\":\"Alice\",\"emotion\":\"happy\",\"confidence\":0.91,\"valence\":0.72,\"arousal\":0.33}"
      }
    },
    {
      "id": "assert-social-state",
      "action": "assertState",
      "expectedState": "SocialSituationAssessment"
    },
    {
      "id": "assert-social-context-has-alice",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "SocialContext",
          "contains": "\"name\":\"Alice\""
        },
        {
          "key": "SocialContext",
          "contains": "\"estimatedUserCount\":1"
        }
      ]
    },
    {
      "id": "generate-social-proactive-greeting",
      "action": "generate",
      "expectedBehaviour": {
        "speech": "Hello Alice, nice to see you. If you want, tell me how I can help.",
        "nonVerbal": {
          "gesture": "ACKNOWLEDGE"
        }
      }
    },
    {
      "id": "ack-social-grouping-stay-social",
      "action": "acknowledge",
      "event": {
        "type": "obs.social.grouping",
        "actor": "user",
        "kind": "observation",
        "payload": "{\"groupCount\":2,\"note\":\"two people standing near the screen\"}"
      }
    },
    {
      "id": "assert-still-social",
      "action": "assertState",
      "expectedState": "SocialSituationAssessment"
    },
    {
      "id": "ack-direct-user-request-transition-to-conversation",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Can you help me plan my next tasks?"
      }
    },
    {
      "id": "assert-conversation-state",
      "action": "assertState",
      "expectedState": "ConversationHandling"
    },
    {
      "id": "assert-social-context-has-direct-request",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "SocialContext",
          "contains": "\"present\":true"
        },
        {
          "key": "SocialContext",
          "contains": "plan my next tasks"
        }
      ]
    },
    {
      "id": "generate-conversation-response",
      "action": "generate",
      "expectedBehaviour": {
        "speech": "Sure. Tell me your top priority and deadline, and we will make a short plan.",
        "nonVerbal": {
          "gesture": "OPEN_QUESTION"
        }
      }
    }
  ],
  "gatewayCalls": [
    {
      "method": "complete",
      "value": "Hello everyone. I can help if you need anything."
    },
    {
      "method": "complete",
      "value": "POLITE"
    },
    {
      "method": "decide",
      "value": true
    },
    {
      "method": "extract",
      "value": {
        "lastUpdateEventType": "obs.emotion.face",
        "estimatedUserCount": 1,
        "users": [
          {
            "name": "Alice",
            "latestEmotion": "happy",
            "confidence": 0.91
          }
        ],
        "latestDirectRequest": {
          "present": false,
          "summary": ""
        }
      }
    },
    {
      "method": "complete",
      "value": "Hello Alice, nice to see you. If you want, tell me how I can help."
    },
    {
      "method": "complete",
      "value": "ACKNOWLEDGE"
    },
    {
      "method": "decide",
      "value": false
    },
    {
      "method": "decide",
      "value": true
    },
    {
      "method": "extract",
      "value": {
        "lastUpdateEventType": "obs.user_utterance",
        "estimatedUserCount": 2,
        "users": [
          {
            "name": "Alice",
            "latestEmotion": "happy",
            "confidence": 0.91
          },
          {
            "name": "unknown",
            "latestEmotion": "neutral",
            "confidence": 0.6
          }
        ],
        "latestDirectRequest": {
          "present": true,
          "summary": "Can you help me plan my next tasks?"
        }
      }
    },
    {
      "method": "complete",
      "value": "Sure. Tell me your top priority and deadline, and we will make a short plan."
    },
    {
      "method": "complete",
      "value": "OPEN_QUESTION"
    }
  ]
}

