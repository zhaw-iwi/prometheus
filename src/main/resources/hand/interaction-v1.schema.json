          "$ref": "#/$defs/id"
        },
        "handedness": {
          "$ref": "#/$defs/side"
        },
        "fingers": {
          "$ref": "#/$defs/fingerReadings"
        },
        "fingerStates": {
          "$ref": "#/$defs/fingerStates"
