        "middle": {
          "anyOf": [
            {
              "enum": [
                "straight",
                "neutral",
                "bent"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ring": {
          "anyOf": [
            {
              "enum": [
                "straight",
                "neutral",
                "bent"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "little": {
          "anyOf": [
            {
              "enum": [
