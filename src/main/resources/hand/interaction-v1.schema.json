        "right",
        "unknown"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "frame": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "space": {
          "enum": [
            "camera_image",
            "robot_local",
            "virtual_scene"
          ]
        },
        "mirrored": {
          "const": false
