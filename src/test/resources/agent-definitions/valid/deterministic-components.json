{
  "$schema": "/agent-definitions/schema/agent-definition.schema.json",
  "schemaVersion": 1,
  "key": "core.deterministic_fixture",
  "revision": 1,
  "metadata": {
    "displayName": "Deterministic fixture",
    "description": "Exercises storage, resources, prompts, and verification records.",
    "categoryPath": "core",
    "languageCode": "en-GB",
    "tags": ["test.fixture"]
  },
  "interaction": {
    "supportedObservations": ["obs.hand.sign"],
    "supportedBehaviourModalities": ["motion.handSign", "display"],
    "profileTags": ["test.fixture"]
  },
  "lifecycle": {
    "initialStateId": "round",
    "startOnCreation": true,
    "initializers": [
      {
        "kind": "prometheus.initializer.constant",
        "version": 1,
        "config": {
          "storageKey": "round_count",
          "value": 0
        }
      }
    ],
    "reset": {
      "storage": "initial",
      "history": "clear"
    }
  },
  "storage": [
    {
      "key": "round_count",
      "description": "Completed round count.",
      "valueSchema": {
        "type": "integer",
        "minimum": 0
      },
      "required": true,
      "visibility": "outcome",
      "reset": "initial",
      "examples": [0, 3]
    }
  ],
  "resources": [
    {
      "id": "signs",
      "kind": "prometheus.resource.typed-choices",
      "version": 1,
      "config": {
        "values": ["rock", "paper", "scissors"]
      }
    }
  ],
  "states": [
    {
      "id": "round",
      "name": "Round",
      "kind": "atomic",
      "entryMode": "start",
      "oblivious": false,
      "eventSelector": {
        "kind": "prometheus.selector.state-path",
        "version": 1,
        "config": {}
      },
      "policy": {
        "kind": "prometheus.policy.prompt",
        "version": 1,
        "config": {
          "responsePrompt": {
            "sections": [
              {
                "id": "response.objective",
                "kind": "objective",
                "content": "Describe the deterministic result."
              }
            ]
          }
        }
      }
    }
  ],
  "transitions": [
    {
      "id": "repeat",
      "sourceStateId": "round",
      "targetStateId": "round",
      "order": 10,
      "decisions": [
        {
          "kind": "prometheus.decision.latest-event-type",
          "version": 1,
          "config": {
            "eventType": "obs.hand.sign"
          }
        }
      ],
      "actions": [
        {
          "kind": "prometheus.action.increment",
          "version": 1,
          "config": {
            "targetStorageKey": "round_count"
          }
        }
      ]
    }
  ],
  "verification": {
    "scenarios": [
      {
        "name": "One deterministic round",
        "description": "A hand sign increments the round counter.",
        "initializerSeed": 7,
        "initialStorage": {
          "round_count": 0
        },
        "events": [
          {
            "type": "obs.hand.sign",
            "actor": "user",
            "kind": "observation",
            "payload": "rock"
          }
        ],
        "expected": {
          "activeStatePath": ["round"],
          "storage": {
            "round_count": 1
          },
          "behaviourFragments": [
            {
              "display": "round-result"
            }
          ]
        }
      }
    ]
  }
}
