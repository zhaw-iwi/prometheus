{
    "name":  "single_state_micro_coaching_complete_and_quit_v1_realtime",
    "steps":  [
                  {
                      "id":  "start-coaching",
                      "action":  "start",
                      "expectedBehaviour":  {
                                                "speech":  "Welche Veraenderung willst du erreichen, und warum ist sie jetzt wichtig?"
                                            }
                  },
                  {
                      "id":  "assert-specialized-state",
                      "action":  "assertState",
                      "expectedState":  "Persuasion Micro Coach"
                  },
                  {
                      "id":  "ack-instate-before-complete",
                      "action":  "acknowledge",
                      "event":  {
                                    "type":  "obs.user_utterance",
                                    "actor":  "user",
                                    "kind":  "observation",
                                    "payload":  "Ich bin noch unsicher, wie ich anfangen soll."
                                }
                  },
                  {
                      "id":  "assert-specialized-still-before-complete",
                      "action":  "assertState",
                      "expectedState":  "Persuasion Micro Coach"
                  },
                  {
                      "id":  "generate-instate-before-complete",
                      "action":  "generate",
                      "expectedBehaviour":  {
                                                "speech":  "Verstaendlich. Was waere heute der kleinste machbare erste Schritt?"
                                            }
                  },
                  {
                      "id":  "ack-complete-coaching",
                      "action":  "acknowledge",
                      "event":  {
                                    "type":  "obs.user_utterance",
                                    "actor":  "user",
                                    "kind":  "observation",
                                    "payload":  "Ich committe mich dazu."
                                },
                      "expectedBehaviour":  {
                                                "speech":  "Coaching abgeschlossen. Viel Erfolg bei der Umsetzung."
                                            }
                  },
                  {
                      "id":  "assert-final-after-complete",
                      "action":  "assertState",
                      "expectedState":  "Session Goodbye Final"
                  },
                  {
                      "id":  "assert-outcome-complete",
                      "action":  "assertStorage",
                      "expectedStorage":  [
                                              {
                                                  "key":  "outcome",
                                                  "contains":  "\"interaction_type\":\"micro_coaching\""
                                              },
                                              {
                                                  "key":  "outcome",
                                                  "contains":  "\"completed\":true"
                                              }
                                          ]
                  },
                  {
                      "id":  "reset-agent",
                      "action":  "reset",
                      "expectedBehaviour":  {
                                                "speech":  "Welche Veraenderung willst du erreichen, und warum ist sie jetzt wichtig?"
                                            }
                  },
                  {
                      "id":  "assert-specialized-after-reset",
                      "action":  "assertState",
                      "expectedState":  "Persuasion Micro Coach"
                  },
                  {
                      "id":  "ack-instate-before-quit",
                      "action":  "acknowledge",
                      "event":  {
                                    "type":  "obs.user_utterance",
                                    "actor":  "user",
                                    "kind":  "observation",
                                    "payload":  "Ich zoegere noch, ob ich das wirklich schaffe."
                                }
                  },
                  {
                      "id":  "assert-specialized-still-before-quit",
                      "action":  "assertState",
                      "expectedState":  "Persuasion Micro Coach"
                  },
                  {
                      "id":  "generate-instate-before-quit",
                      "action":  "generate",
                      "expectedBehaviour":  {
                                                "speech":  "Danke fuer die Offenheit. Welche mini Version des Schritts waere heute realistisch?"
                                            }
                  },
                  {
                      "id":  "ack-global-quit",
                      "action":  "acknowledge",
                      "event":  {
                                    "type":  "obs.user_utterance",
                                    "actor":  "user",
                                    "kind":  "observation",
                                    "payload":  "Lass uns hier aufhoeren."
                                },
                      "expectedBehaviour":  {
                                                "speech":  "Sitzung frueh beendet. Danke und bis bald."
                                            }
                  },
                  {
                      "id":  "assert-final-after-quit",
                      "action":  "assertState",
                      "expectedState":  "Session Goodbye Final"
                  },
                  {
                      "id":  "assert-outcome-quit",
                      "action":  "assertStorage",
                      "expectedStorage":  [
                                              {
                                                  "key":  "outcome",
                                                  "contains":  "\"interaction_type\":\"micro_coaching\""
                                              },
                                              {
                                                  "key":  "outcome",
                                                  "contains":  "\"completed\":false"
                                              }
                                          ]
                  }
              ],
    "gatewayCalls":  [
                         {
                             "method":  "complete",
                             "value":  "Welche Veraenderung willst du erreichen, und warum ist sie jetzt wichtig?"
                         },
                         {
                             "method":  "decide",
                             "value":  false
                         },
                         {
                             "method":  "decide",
                             "value":  true
                         },
                         {
                             "method":  "extract",
                             "value":  {
                                           "flow_type":  "single_state",
                                           "outcomes":  [
                                                            {
                                                                "interaction_type":  "micro_coaching",
                                                                "completed":  true,
                                                                "result_summary":  "Concrete micro action and commitment were confirmed.",
                                                                "user_confirmation":  "Ich committe mich dazu."
                                                            }
                                                        ],
                                           "overall_summary":  "Micro coaching completed."
                                       }
                         },
                         {
                             "method":  "complete",
                             "value":  "Coaching abgeschlossen. Viel Erfolg bei der Umsetzung."
                         },
                         {
                             "method":  "complete",
                             "value":  "Welche Veraenderung willst du erreichen, und warum ist sie jetzt wichtig?"
                         },
                         {
                             "method":  "decide",
                             "value":  false
                         },
                         {
                             "method":  "decide",
                             "value":  true
                         },
                         {
                             "method":  "extract",
                             "value":  {
                                           "flow_type":  "single_state",
                                           "outcomes":  [
                                                            {
                                                                "interaction_type":  "micro_coaching",
                                                                "completed":  false,
                                                                "result_summary":  "Session ended early by global quit intent.",
                                                                "user_confirmation":  null
                                                            }
                                                        ],
                                           "overall_summary":  "Global quit."
                                       }
                         },
                         {
                             "method":  "complete",
                             "value":  "Sitzung frueh beendet. Danke und bis bald."
                         },
                         {
                             "method":  "complete",
                             "value":  "Die Sitzung ist abgeschlossen. Fuer weitere Nachrichten starte bitte eine neue Sitzung."
                         }
                     ]
}
