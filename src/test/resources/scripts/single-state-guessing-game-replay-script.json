{
  "name": "single_state_guessing_game_complete_and_quit_v1",
  "steps": [
    {
      "id": "start-guessing",
      "action": "start",
      "expectedBehaviour": {
        "speech": "Denke an eine Sache. Ich stelle Ja/Nein-Fragen und mache dann einen finalen Tipp."
      }
    },
    {
      "id": "assert-specialized-state",
      "action": "assertState",
      "expectedState": "Questions Based Guesser"
    },
    {
      "id": "ack-complete-guessing",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Du hast es erraten."
      },
      "expectedBehaviour": {
        "speech": "Ratespiel abgeschlossen. Danke fuer die Runde."
      }
    },
    {
      "id": "assert-final-after-complete",
      "action": "assertState",
      "expectedState": "Session Goodbye Final"
    },
    {
      "id": "assert-outcome-complete",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"guessing_game\""
        },
        {
          "key": "outcome",
          "contains": "\"completed\":true"
        }
      ]
    },
    {
      "id": "reset-agent",
      "action": "reset",
      "expectedBehaviour": {
        "speech": "Denke an eine Sache. Ich stelle Ja/Nein-Fragen und mache dann einen finalen Tipp."
      }
    },
    {
      "id": "assert-specialized-after-reset",
      "action": "assertState",
      "expectedState": "Questions Based Guesser"
    },
    {
      "id": "ack-global-quit",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Ich moechte die Interaktion beenden."
      },
      "expectedBehaviour": {
        "speech": "Sitzung frueh beendet. Danke und bis bald."
      }
    },
    {
      "id": "assert-final-after-quit",
      "action": "assertState",
      "expectedState": "Session Goodbye Final"
    },
    {
      "id": "assert-outcome-quit",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"guessing_game\""
        },
        {
          "key": "outcome",
          "contains": "\"completed\":false"
        }
      ]
    }
  ],
  "gatewayCalls": [
    {
      "method": "complete",
      "value": "Denke an eine Sache. Ich stelle Ja/Nein-Fragen und mache dann einen finalen Tipp."
    },
    {
      "method": "decide",
      "value": true
    },
    {
      "method": "extract",
      "value": {
        "flow_type": "single_state",
        "outcomes": [
          {
            "interaction_type": "guessing_game",
            "completed": true,
            "result_summary": "Assistant guess was confirmed by the user.",
            "user_confirmation": "Du hast es erraten."
          }
        ],
        "overall_summary": "Guessing game completed."
      }
    },
    {
      "method": "complete",
      "value": "Ratespiel abgeschlossen. Danke fuer die Runde."
    },
    {
      "method": "complete",
      "value": "Denke an eine Sache. Ich stelle Ja/Nein-Fragen und mache dann einen finalen Tipp."
    },
    {
      "method": "decide",
      "value": true
    },
    {
      "method": "extract",
      "value": {
        "flow_type": "single_state",
        "outcomes": [
          {
            "interaction_type": "guessing_game",
            "completed": false,
            "result_summary": "Session ended early by global quit intent.",
            "user_confirmation": null
          }
        ],
        "overall_summary": "Global quit."
      }
    },
    {
      "method": "complete",
      "value": "Sitzung frueh beendet. Danke und bis bald."
    }
  ]
}
