{
  "name": "single_state_co_creation_complete_and_quit_v1",
  "steps": [
    {
      "id": "start-story",
      "action": "start",
      "expectedBehaviour": {
        "speech": "Waehle bitte ein Genre und eine Figur fuer den Start."
      }
    },
    {
      "id": "assert-specialized-state",
      "action": "assertState",
      "expectedState": "Story Co Creation"
    },
    {
      "id": "ack-complete-story",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Die Geschichte ist zu Ende."
      },
      "expectedBehaviour": {
        "speech": "Story abgeschlossen. Danke fuer die kreative Runde."
      }
    },
    {
      "id": "assert-final-after-complete",
      "action": "assertState",
      "expectedState": "Session Goodbye Final"
    },
    {
      "id": "assert-outcome-complete",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"story_co_creation\""
        },
        {
          "key": "outcome",
          "contains": "\"completed\":true"
        }
      ]
    },
    {
      "id": "reset-agent",
      "action": "reset",
      "expectedBehaviour": {
        "speech": "Waehle bitte ein Genre und eine Figur fuer den Start."
      }
    },
    {
      "id": "assert-specialized-after-reset",
      "action": "assertState",
      "expectedState": "Story Co Creation"
    },
    {
      "id": "ack-global-quit",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Ich moechte die Interaktion beenden."
      },
      "expectedBehaviour": {
        "speech": "Sitzung frueh beendet. Danke und bis bald."
      }
    },
    {
      "id": "assert-final-after-quit",
      "action": "assertState",
      "expectedState": "Session Goodbye Final"
    },
    {
      "id": "assert-outcome-quit",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"story_co_creation\""
        },
        {
          "key": "outcome",
          "contains": "\"completed\":false"
        }
      ]
    }
  ],
  "gatewayCalls": [
    {
      "method": "complete",
      "value": "Waehle bitte ein Genre und eine Figur fuer den Start."
    },
    {
      "method": "decide",
      "value": true
    },
    {
      "method": "extract",
      "value": {
        "flow_type": "single_state",
        "outcomes": [
          {
            "interaction_type": "story_co_creation",
            "completed": true,
            "result_summary": "Story ending was reached and explicitly confirmed.",
            "user_confirmation": "Die Geschichte ist zu Ende."
          }
        ],
        "overall_summary": "Story co-creation completed."
      }
    },
    {
      "method": "complete",
      "value": "Story abgeschlossen. Danke fuer die kreative Runde."
    },
    {
      "method": "complete",
      "value": "Waehle bitte ein Genre und eine Figur fuer den Start."
    },
    {
      "method": "decide",
      "value": true
    },
    {
      "method": "extract",
      "value": {
        "flow_type": "single_state",
        "outcomes": [
          {
            "interaction_type": "story_co_creation",
            "completed": false,
            "result_summary": "Session ended early by global quit intent.",
            "user_confirmation": null
          }
        ],
        "overall_summary": "Global quit."
      }
    },
    {
      "method": "complete",
      "value": "Sitzung frueh beendet. Danke und bis bald."
    }
  ]
}
