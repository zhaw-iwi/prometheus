{
  "name": "four_states_circular_all_options_quit_last_v1",
  "steps": [
    {
      "id": "start-base-menu",
      "action": "start",
      "expectedBehaviour": {
        "speech": "Hallo. Waehle bitte eine Option: 1) Ratespiel, 2) Mikro-Coach, 3) Story-Co-Creation, 4) Interaktion beenden."
      }
    },
    {
      "id": "choose-option-1-guesser",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Option 1"
      },
      "expectedBehaviour": {
        "speech": "Denke an eine Sache. Ich stelle Ja/Nein-Fragen und mache dann einen finalen Tipp. Antworte mit 'Bereit', sobald du etwas hast."
      }
    },
    {
      "id": "assert-guesser-state",
      "action": "assertState",
      "expectedState": "Questions Based Guesser"
    },
    {
      "id": "complete-guesser-return-base",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Du hast es erraten."
      },
      "expectedBehaviour": {
        "speech": "Willkommen zurueck im Menue. Waehle bitte 1, 2, 3 oder 4."
      }
    },
    {
      "id": "assert-base-after-guesser",
      "action": "assertState",
      "expectedState": "Base Menu"
    },
    {
      "id": "choose-option-2-coach",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Option 2"
      },
      "expectedBehaviour": {
        "speech": "Welche Veraenderung willst du erreichen, und warum ist sie jetzt wichtig?"
      }
    },
    {
      "id": "assert-coach-state",
      "action": "assertState",
      "expectedState": "Persuasion Micro Coach"
    },
    {
      "id": "complete-coach-return-base",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Ich committe mich dazu."
      },
      "expectedBehaviour": {
        "speech": "Zurueck im Menue. Du kannst wieder 1, 2, 3 oder 4 waehlen."
      }
    },
    {
      "id": "assert-base-after-coach",
      "action": "assertState",
      "expectedState": "Base Menu"
    },
    {
      "id": "choose-option-3-story",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Option 3"
      },
      "expectedBehaviour": {
        "speech": "Waehle bitte ein Genre und eine Figur fuer den Start."
      }
    },
    {
      "id": "assert-story-state",
      "action": "assertState",
      "expectedState": "Story Co Creation"
    },
    {
      "id": "complete-story-return-base",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Die Geschichte ist zu Ende."
      },
      "expectedBehaviour": {
        "speech": "Super. Wir sind wieder im Menue. Waehle 1, 2, 3 oder 4."
      }
    },
    {
      "id": "assert-base-after-story",
      "action": "assertState",
      "expectedState": "Base Menu"
    },
    {
      "id": "choose-option-4-quit",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Option 4"
      },
      "expectedBehaviour": {
        "speech": "Danke fuer die Session. Heute hast du Ratespiel, Mikro-Coach und Story gemacht. Bis bald."
      }
    },
    {
      "id": "assert-final-state",
      "action": "assertState",
      "expectedState": "Session Goodbye Final"
    },
    {
      "id": "assert-outcome-storage",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"flow_type\":\"circular\""
        },
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"guessing_game\""
        },
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"micro_coaching\""
        },
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"story_co_creation\""
        }
      ]
    }
  ],
