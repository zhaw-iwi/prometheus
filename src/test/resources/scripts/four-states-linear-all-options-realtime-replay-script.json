{
    "name":  "four_states_linear_all_options_with_reset_quit_last_v1_realtime",
    "steps":  [
                  {
                      "id":  "start-base-menu",
                      "action":  "start",
                      "expectedBehaviour":  {
                                                "speech":  "Hallo. Waehle bitte eine Option: 1) Ratespiel, 2) Mikro-Coach, 3) Story-Co-Creation, 4) Interaktion beenden."
                                            }
                  },
                  {
                      "id":  "ack-base-non-transition",
                      "action":  "acknowledge",
                      "event":  {
                                    "type":  "obs.user_utterance",
                                    "actor":  "user",
                                    "kind":  "observation",
                                    "payload":  "Was kannst du alles?"
                                }
                  },
                  {
                      "id":  "assert-base-still-before-choice",
                      "action":  "assertState",
                      "expectedState":  "Base Menu"
                  },
                  {
                      "id":  "generate-base-guidance",
                      "action":  "generate",
                      "expectedBehaviour":  {
                                                "speech":  "Ich kann dir beim Ratespiel, Mikro-Coaching oder Story-Co-Creation helfen. Waehle bitte 1, 2, 3 oder 4."
                                            }
                  },
                  {
                      "id":  "choose-option-1-guesser",
