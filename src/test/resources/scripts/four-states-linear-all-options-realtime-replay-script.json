                                    "type":  "obs.user_utterance",
                                    "actor":  "user",
                                    "kind":  "observation",
                                    "payload":  "Option 1"
                                },
                      "expectedBehaviour":  {
                                                "speech":  "Denke an eine Sache. Ich stelle Ja/Nein-Fragen und mache dann einen finalen Tipp. Antworte mit \u0027Bereit\u0027, sobald du etwas hast."
