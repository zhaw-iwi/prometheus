{
  "name": "four_states_linear_all_options_with_reset_quit_last_v1",
  "steps": [
    {
      "id": "start-base-menu",
      "action": "start",
      "expectedBehaviour": {
        "speech": "Hallo. Waehle bitte eine Option: 1) Ratespiel, 2) Mikro-Coach, 3) Story-Co-Creation, 4) Interaktion beenden."
      }
    },
    {
      "id": "choose-option-1-guesser",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Option 1"
      },
      "expectedBehaviour": {
        "speech": "Denke an eine Sache. Ich stelle Ja/Nein-Fragen und mache dann einen finalen Tipp. Antworte mit 'Bereit', sobald du etwas hast."
      }
    },
    {
      "id": "assert-guesser-state",
      "action": "assertState",
      "expectedState": "Questions Based Guesser"
    },
    {
      "id": "complete-guesser-to-activity-final",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Du hast es erraten."
      },
      "expectedBehaviour": {
        "speech": "Ratespiel abgeschlossen. Danke, bis zur naechsten Runde."
      }
    },
    {
      "id": "assert-activity-final-after-guesser",
      "action": "assertState",
      "expectedState": "Activity Summary Final"
    },
    {
      "id": "assert-outcome-guesser",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"guessing_game\""
        }
      ]
    },
    {
      "id": "reset-after-guesser",
      "action": "reset",
      "expectedBehaviour": {
        "speech": "Hallo. Waehle bitte eine Option: 1) Ratespiel, 2) Mikro-Coach, 3) Story-Co-Creation, 4) Interaktion beenden."
      }
    },
    {
      "id": "assert-base-after-reset-1",
