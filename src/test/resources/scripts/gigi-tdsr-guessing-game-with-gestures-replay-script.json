{
  "name": "gigi_tdsr_guessing_game_with_gestures_v1",
  "steps": [
    {
      "id": "start-gesture-guessing-game",
      "action": "start",
      "expectedBehaviour": {
        "speech": "Hallo, ich bin GIGI. Denk an etwas Vertrautes, und sag Bereit, sobald ich losfragen darf.",
        "nonVerbal": {
          "gesture": "POLITE",
          "facialExpression": {"type": "welcoming", "intensity": 0.7},
          "gaze": {"direction": "forward", "focus": "user"},
          "posture": {"type": "open", "lean": "neutral", "openness": 0.8},
          "prosody": {"rate": "medium-slow", "pitch": "warm", "volume": "soft"},
          "motion": {"stillness": 0.2, "energy": 0.3}
        }
      }
    },
    {
      "id": "assert-interaction-state-after-start",
      "action": "assertState",
      "expectedState": "GIGI TDSR Gesten-Ratespiel"
    },
    {
      "id": "ack-ready",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Bereit."
      }
    },
    {
      "id": "assert-still-interaction-after-ready",
      "action": "assertState",
      "expectedState": "GIGI TDSR Gesten-Ratespiel"
    },
    {
      "id": "generate-first-question",
      "action": "generate",
      "expectedBehaviour": {
        "speech": "Gut, dann frage ich vorsichtig: Ist es etwas, das man drinnen benutzt?",
        "nonVerbal": {
          "gesture": "OPEN_QUESTION",
          "facialExpression": {"type": "curious", "intensity": 0.6},
          "gaze": {"direction": "forward", "focus": "user"},
          "posture": {"type": "attentive", "lean": "slight_forward", "openness": 0.7},
          "prosody": {"rate": "medium", "pitch": "light", "volume": "normal"},
          "motion": {"stillness": 0.3, "energy": 0.4}
        }
      }
    },
    {
      "id": "ack-answer-no",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Nein."
      }
    },
    {
      "id": "generate-final-guess",
      "action": "generate",
      "expectedBehaviour": {
        "speech": "Dann tippe ich auf etwas draussen. Ist es vielleicht ein Baum?",
        "nonVerbal": {
          "gesture": "EXPLAIN",
          "facialExpression": {"type": "focused", "intensity": 0.65},
          "gaze": {"direction": "forward", "focus": "user"},
          "posture": {"type": "presenting", "lean": "neutral", "openness": 0.75},
          "prosody": {"rate": "medium", "pitch": "confident", "volume": "normal"},
          "motion": {"stillness": 0.25, "energy": 0.45}
        }
      }
    },
    {
      "id": "ack-confirm-guess",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Ja, das war richtig."
      }
    },
    {
      "id": "assert-still-interaction-after-confirmation",
      "action": "assertState",
      "expectedState": "GIGI TDSR Gesten-Ratespiel"
    },
    {
      "id": "generate-wrap-up-question",
      "action": "generate",
      "expectedBehaviour": {
        "speech": "Das freut mich. Moechtest du noch eine Runde spielen oder soll ich aufhoeren?",
        "nonVerbal": {
          "gesture": "ACKNOWLEDGE",
          "facialExpression": {"type": "pleased", "intensity": 0.7},
          "gaze": {"direction": "forward", "focus": "user"},
          "posture": {"type": "relaxed_open", "lean": "neutral", "openness": 0.8},
          "prosody": {"rate": "medium-slow", "pitch": "warm", "volume": "normal"},
          "motion": {"stillness": 0.35, "energy": 0.35}
        }
      }
    },
    {
      "id": "ack-explicit-exit",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Nein, lass uns hier aufhoeren."
      },
      "expectedBehaviour": {
        "speech": "Danke fuer das Ratespiel. Ich hoere jetzt auf und verabschiede mich freundlich."
      }
    },
    {
      "id": "assert-final-after-exit",
      "action": "assertState",
      "expectedState": "GIGI TDSR Gesten-Ratespiel Abschluss"
    },
    {
      "id": "assert-outcome",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"guessing_game_with_gestures\""
        },
        {
          "key": "outcome",
          "contains": "\"completed\":true"
        },
        {
          "key": "outcome",
          "contains": "\"gesture_demo\":true"
        }
      ]
    }
  ],
