{
  "name": "gigi_tdsr_social_context_sensitivity_v1",
  "steps": [
    {
      "id": "start-social-context-agent",
      "action": "start",
      "expectedBehaviour": {
        "speech": "Hallo, ich bin GIGI. Ich kann mit dir sprechen und auf soziale Veraenderungen in meiner Naehe reagieren."
      }
    },
    {
      "id": "assert-social-context-state",
      "action": "assertState",
      "expectedState": "GIGI TDSR Social Context"
    },
    {
      "id": "ack-no-one-nearby",
      "action": "acknowledge",
      "event": {
        "type": "obs.social.grouping",
        "actor": "user",
        "kind": "observation",
        "payload": "{\"source\":\"visual.social\",\"humanCount\":0,\"groupCount\":0,\"singletonCount\":0,\"largestGroupSize\":0,\"groupSizes\":[],\"groups\":[]}"
      },
      "expectedBehaviour": {
        "speech": "Gerade scheint niemand in meiner Naehe zu sein. Da wird es fuer einen sozialen Roboter fast ein bisschen still."
      }
    },
    {
      "id": "ack-arrival",
      "action": "acknowledge",
      "event": {
        "type": "obs.social.grouping",
        "actor": "user",
        "kind": "observation",
        "payload": "{\"source\":\"visual.social\",\"humanCount\":1,\"groupCount\":0,\"singletonCount\":1,\"largestGroupSize\":1,\"groupSizes\":[1],\"groups\":[{\"memberIds\":[1]}]}"
      },
      "expectedBehaviour": {
        "speech": "Hallo, ich habe bemerkt, dass jemand dazugekommen ist. Schoen, dass du da bist."
      }
    },
    {
      "id": "ack-crowd",
      "action": "acknowledge",
      "event": {
        "type": "obs.social.grouping",
        "actor": "user",
        "kind": "observation",
        "payload": "{\"source\":\"visual.social\",\"humanCount\":3,\"groupCount\":1,\"singletonCount\":0,\"largestGroupSize\":3,\"groupSizes\":[3],\"groups\":[{\"memberIds\":[1,2,3]}]}"
      },
      "expectedBehaviour": {
        "speech": "Hallo zusammen. Mit so vielen Menschen hier habe ich gerade nicht gerechnet."
      }
    },
    {
      "id": "ack-normal-conversation",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Was kannst du?"
      }
    },
    {
      "id": "generate-normal-conversation",
      "action": "generate",
      "expectedBehaviour": {
        "speech": "Ich kann mit dir sprechen und zugleich auf soziale Veraenderungen reagieren, zum Beispiel wenn jemand kommt oder geht."
      }
    },
    {
      "id": "ack-departure",
      "action": "acknowledge",
      "event": {
        "type": "obs.social.grouping",
        "actor": "user",
        "kind": "observation",
        "payload": "{\"source\":\"visual.social\",\"humanCount\":0,\"groupCount\":0,\"singletonCount\":0,\"largestGroupSize\":0,\"groupSizes\":[],\"groups\":[]}"
      },
      "expectedBehaviour": {
        "speech": "Tschuess, ich habe bemerkt, dass die Runde wieder gegangen ist. Ich bleibe ruhig hier."
      }
    },
    {
      "id": "ack-explicit-exit",
      "action": "acknowledge",
      "event": {
        "type": "obs.user_utterance",
        "actor": "user",
        "kind": "observation",
        "payload": "Bitte beende das Gespraech jetzt."
      },
      "expectedBehaviour": {
        "speech": "Alles klar. Ich beende die Social-Context-Demo und verabschiede mich freundlich."
      }
    },
    {
      "id": "assert-final-after-exit",
      "action": "assertState",
      "expectedState": "GIGI TDSR Social Context Abschluss"
    },
    {
      "id": "assert-outcome",
      "action": "assertStorage",
      "expectedStorage": [
        {
          "key": "outcome",
          "contains": "\"interaction_type\":\"social_context_sensitivity\""
        },
        {
          "key": "outcome",
          "contains": "\"reacted_to_social_events\":true"
        },
        {
          "key": "outcome",
          "contains": "\"arrival\""
        }
      ]
    }
  ],
  "gatewayCalls": [
    {
      "method": "complete",
      "value": "Hallo, ich bin GIGI. Ich kann mit dir sprechen und auf soziale Veraenderungen in meiner Naehe reagieren."
    },
    {
      "method": "complete",
      "value": "Gerade scheint niemand in meiner Naehe zu sein. Da wird es fuer einen sozialen Roboter fast ein bisschen still."
    },
    {
      "method": "complete",
      "value": "Hallo, ich habe bemerkt, dass jemand dazugekommen ist. Schoen, dass du da bist."
    },
    {
      "method": "complete",
      "value": "Hallo zusammen. Mit so vielen Menschen hier habe ich gerade nicht gerechnet."
    },
    {
      "method": "decide",
      "value": false
    },
    {
      "method": "complete",
      "value": "Ich kann mit dir sprechen und zugleich auf soziale Veraenderungen reagieren, zum Beispiel wenn jemand kommt oder geht."
    },
    {
      "method": "complete",
      "value": "Tschuess, ich habe bemerkt, dass die Runde wieder gegangen ist. Ich bleibe ruhig hier."
    },
    {
      "method": "decide",
      "value": true
    },
    {
      "method": "extract",
      "value": {
        "flow_type": "single_state",
        "outcomes": [
          {
            "interaction_type": "social_context_sensitivity",
            "completed": true,
            "reacted_to_social_events": true,
            "observed_change_types": ["now_alone", "arrival", "crowd_detected", "departure"],
            "conversation_summary": "The user asked what GIGI can do.",
            "result_summary": "GIGI reacted to social context changes and the user ended the demo."
          }
        ],
        "overall_summary": "Social context sensitivity demo completed."
      }
    },
    {
      "method": "complete",
      "value": "Alles klar. Ich beende die Social-Context-Demo und verabschiede mich freundlich."
    },
    {
      "method": "complete",
      "value": "Die Social-Context-Demo ist beendet. Auf Wiedersehen."
    }
  ]
}
